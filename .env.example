# Server-only. Use the dedicated buddy_keynote_app login through Supabase's
# transaction pooler (port 6543), never postgres or a Supabase service-role key.
BUDDY_DATABASE_URL=postgresql://buddy_keynote_app.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres
# Generate with: openssl rand -hex 24. Share privately with document creators.
BUDDY_CREATE_KEY=
# Set to your canonical production origin, without a trailing slash.
BUDDY_APP_ORIGIN=http://localhost:3000
# Optional PEM root certificate when your database uses a private CA.
BUDDY_DATABASE_CA=
